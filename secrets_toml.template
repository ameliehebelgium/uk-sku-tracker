# Streamlit secrets 配置模板 —— 英国 (UK) SKU 比对系统专用
#
# ⚠️ 重要：UK_SHEET_ID 必须指向一个全新的、独立于 EU Risk App 的 Google Sheet 文件。
#    不要填入 EU Risk App 那边正在使用的 Sheet ID，否则两套数据会写到同一个文件里。
#
# 部署到 Streamlit Cloud 时，把内容粘贴到 App Settings -> Secrets
# 本地调试时，复制本文件为 .streamlit/secrets.toml 并填入真实值（该文件不要上传到 Git）

# 登录用的用户名/密码（可选）。不配置的话，代码里会用 Admin / Admin123 兜底，
# 但生产环境建议在这里改成自己的密码，这样改密码不需要动代码。
ADMIN_USERNAME = "Admin"
ADMIN_PASSWORD = "Admin123"

UK_SHEET_ID = "你新建的 UK 专属 Google Sheet 的 ID（从网址中间一段获取）"

[gcp_service_account]
type = "service_account"
project_id = "你的项目ID"
private_key_id = "..."
private_key = "-----BEGIN PRIVATE KEY-----\n...\n-----END PRIVATE KEY-----\n"
client_email = "xxx@xxx.iam.gserviceaccount.com"
client_id = "..."
auth_uri = "https://accounts.google.com/o/oauth2/auth"
token_uri = "https://oauth2.googleapis.com/token"
auth_provider_x509_cert_url = "https://www.googleapis.com/oauth2/v1/certs"
client_x509_cert_url = "..."

# 提示：
# - 这个 [gcp_service_account] 凭据可以跟 EU Risk App 复用同一个 service account
#   （同一个 Google 账号下的同一个 service account email 即可）。
# - 但前提是：这个 service account 的 email 也必须被添加为
#   「新建的 UK Google Sheet」的编辑者，否则程序无法读写这个新表格。
# - EU Risk App 那边的 service account 共享设置不受影响，两边互不干扰。
